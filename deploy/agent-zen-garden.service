[Unit]
Description=Agent Zen Garden — WebMCP web design server
After=network.target

[Service]
Type=simple
User=ducks
WorkingDirectory=/home/ducks/agent-zen-garden
# Run inside the flake dev shell so node + chromium (and the puppeteer
# env vars from shellHook) are all provided by Nix. Absolute path to the
# nix binary since systemd has a minimal PATH.
ExecStart=/nix/var/nix/profiles/default/bin/nix develop --command node src/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3456

[Install]
WantedBy=multi-user.target
